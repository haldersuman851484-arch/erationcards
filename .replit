modules = ["web", "nodejs-20", "bash"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "local-mysql"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/api-server: API Server"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/ration-card-portal: web"

[[workflows.workflow]]
name = "typecheck"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx tsc -b lib/api-client-react lib/api-zod && pnpm --filter @workspace/api-server typecheck && pnpm --filter @workspace/ration-card-portal typecheck"

[[workflows.workflow]]
name = "test-api"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server test"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "browser-tests"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd artifacts/ration-card-portal && npx playwright test"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "local-mysql"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/local-mysql.sh"

[workflows.workflow.metadata]
outputType = "console"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
EMAIL_FROM = "PVC Card Portal <orders@erationcards.in>"
PROCESSING_EMAIL = "help@erationcards.in"

[userenv.development]
MYSQL_DATABASE_URL = "mysql://app:e1ee10f56b3e05327b96f181@127.0.0.1:3311/rationcards_test"

[objectStorage]
defaultBucketID = "replit-objstore-1385b690-cb6e-4577-a122-1280056f167b"
