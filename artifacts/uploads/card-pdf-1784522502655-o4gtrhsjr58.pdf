    <script type="text/javascript">

        function startTimer() {
            var countDownDate = new Date().getTime() + 120000;
            var x = setInterval(function () {
                var now = new Date().getTime();
                var distance = countDownDate - now;
                var minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
                var seconds = Math.floor((distance % (1000 * 60)) / 1000);
                if (minutes == 0) {
                    $("#ctl00_ContentPlaceHolder1_count").html("Submit your otp  " + seconds + " seconds");
                } else {
                    $("#ctl00_ContentPlaceHolder1_count").html("Please Enter Valid OTP " + minutes + " minutes " + seconds + " seconds ");
                }

                if (distance < 0) {
                    clearInterval(x);

                    document.getElementById("ctl00_ContentPlaceHolder1_timeout_div").setAttribute("style", "display:none;");

                    document.getElementById("ctl00_ContentPlaceHolder1_divResendBtn").style.display = "block";


                }
            }, 1000);
        }

        function startTimerAdhar() {
            var countDownDate = new Date().getTime() + 120000;
            var x = setInterval(function () {
                var now = new Date().getTime();
                var distance = countDownDate - now;
                var minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
                var seconds = Math.floor((distance % (1000 * 60)) / 1000);
                if (minutes == 0) {
                    $("#ctl00_ContentPlaceHolder1_countAdhar").html("Submit your otp  " + seconds + " seconds");
                } else {
                    $("#ctl00_ContentPlaceHolder1_countAdhar").html("Please Enter Valid OTP " + minutes + " minutes " + seconds + " seconds ");
                }

                if (distance < 0) {
                    clearInterval(x);

                    document.getElementById("ctl00_ContentPlaceHolder1_timeout_divAdhar").setAttribute("style", "display:none;");

                    document.getElementById("ctl00_ContentPlaceHolder1_divResendBtn").style.display = "block";


                }
            }, 1000);
        };

        function handleTextChange() {
            //lenth check 4 digit
            var enter_otp = document.getElementById('enter_otp');
            var enter_otp1 = document.getElementById('enter_otp1');
            var enter_otp2 = document.getElementById('enter_otp2');
            var enter_otp3 = document.getElementById('enter_otp3');
            var parameterValue = enter_otp.value + enter_otp1.value + enter_otp2.value + enter_otp3.value;
            if (parameterValue.length === 4) {
                enter_otp.focus();
            }

        };

        function handleTextChangeAdhar() {
            //lenth check 4 digit
            var enter_otp_adhar = document.getElementById('enter_otp_adhar');
            var enter_otp_adhar1 = document.getElementById('enter_otp_adhar1');
            var enter_otp_adhar2 = document.getElementById('enter_otp_adhar2');
            var enter_otp_adhar3 = document.getElementById('enter_otp_adhar3');
            var enter_otp_adhar4 = document.getElementById('enter_otp_adhar4');
            var enter_otp_adhar5 = document.getElementById('enter_otp_adhar5');
            var parameterValue = enter_otp_adhar.value + enter_otp_adhar1.value + enter_otp_adhar2.value + enter_otp_adhar3.value + enter_otp_adhar4.value + enter_otp_adhar5.value;
            if (parameterValue.length === 6) {
                enter_otp_adhar.focus();
            }

        };

        function showmodal(type) {
            if (type == 1) {
                $('#enter_otp1').focus();
                document.getElementById("ctl00_ContentPlaceHolder1_timeout_div").setAttribute("style", "display:none;");
                document.getElementById("ctl00_ContentPlaceHolder1_divResendBtn").style.display = "block";
            }

            $("#exampleModalLong").modal('show');

        };

        function showmodal2(type) {

            if (type == 1) {
               
                $("#ctl00_ContentPlaceHolder1_endTimeLabel").html("The Mobile number not selected will be delinked from your family.");
            }
            else {
                $("#ctl00_ContentPlaceHolder1_endTimeLabel").html("");
            }
           

            $("#exampleModalLong2").modal('show');
        };



        function showmodalAdhar(type) {
            if (type == 1) {
                $('#enter_otp1').focus();
                document.getElementById("ctl00_ContentPlaceHolder1_timeout_div").setAttribute("style", "display:none;");
                document.getElementById("ctl00_ContentPlaceHolder1_divResendBtn").style.display = "block";
            }

            $("#exampleModalLongAdhar").modal('show');

        };

        function hidemodal2() {
            $("#exampleModalLong2").modal('hide');
            $(".modal-backdrop").remove();
        };

        function openaddmobileshow() {
            $("#modal_ekyc_mobile").modal('show');
            
        }


        function openaddmobilehide() {
            $("#modal_ekyc_mobile").modal('hide');
            $(".modal-backdrop").remove();
        };

        function runScript(e, Id, obj) {
            //  alert(e.keyCode)
            if (e.keyCode == 13) {

                $("#Btn_confrm").click(); //jquery
                document.getElementById("Btn_confrm").click(); //javascript
            }
            if (e.keyCode != 8 && e.keyCode != 46) {

                if (Id == 'enter_otp') {
                    $('#enter_otp1').focus();
                }
                if (Id == 'enter_otp1') {
                    $('#enter_otp2').focus();
                }
                if (Id == 'enter_otp2') {
                    $('#enter_otp3').focus();
                }

            }

            var code = (e.which) ? e.which : e.keyCode;

            if (code >= 48 && code <= 57) { return true; }
            else {
                // $(obj).val('');
                return false;
            }
        };

        function runScriptAdhar(e, Id, obj) {
            //  alert(e.keyCode)
            if (e.keyCode == 13) {

                $("#Btn_confrm").click(); //jquery
                document.getElementById("Btn_confrm").click(); //javascript
            }
            if (e.keyCode != 8 && e.keyCode != 46) {

                if (Id == 'enter_otp_adhar') {
                    $('#enter_otp_adhar1').focus();
                }
                if (Id == 'enter_otp_adhar1') {
                    $('#enter_otp_adhar2').focus();
                }
                if (Id == 'enter_otp_adhar2') {
                    $('#enter_otp_adhar3').focus();
                }
                if (Id == 'enter_otp_adhar3') {
                    $('#enter_otp_adhar4').focus();
                }
                if (Id == 'enter_otp_adhar4') {
                    $('#enter_otp_adhar5').focus();
                }

            }

            var code = (e.which) ? e.which : e.keyCode;

            if (code >= 48 && code <= 57) { return true; }
            else {
                // $(obj).val('');
                return false;
            }
        };

    </script>


