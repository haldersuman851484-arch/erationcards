{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -b tsconfig.json",
    "test": "vitest run",
    "test:smoke": "tsx src/tests/orders-search-perf.test.ts"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.21.0",
    "@replit/connectors-sdk": "^0.4.1",
    "@workspace/api-zod": "workspace:*",
    "@workspace/contact": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/pricing": "workspace:*",
    "archiver": "^8.0.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "mysql2": "^3.14.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "catalog:",
    "@types/supertest": "^7.2.1",
    "@vitest/runner": "^4.1.10",
    "esbuild": "0.28.1",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "thread-stream": "3.1.0",
    "tsx": "catalog:",
    "vitest": "^4.1.10"
  }
}
