# ── Database ──────────────────────────────────────────────────────────────────
# Hostinger MySQL connection string (set in Hostinger hPanel → MySQL Databases)
# Format: mysql://USERNAME:PASSWORD@HOST:3306/DATABASE_NAME
MYSQL_DATABASE_URL=mysql://db_user:db_password@localhost:3306/db_name

# ── Auth ──────────────────────────────────────────────────────────────────────
# Long random string used to sign JWTs — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_with_64_hex_chars

# Admin login credentials for the /admin dashboard
ADMIN_EMAIL=admin@erationcards.in
ADMIN_PASSWORD=replace_with_strong_password

# ── Payments ──────────────────────────────────────────────────────────────────
# UPI ID shown on the payment QR code page
MERCHANT_UPI_ID=yourname@bank

# ── Server ────────────────────────────────────────────────────────────────────
# Port the Node.js process listens on.
# Hostinger sets this automatically — do NOT hard-code it.
PORT=3000

# Optional: absolute path for uploaded payment screenshots.
# Defaults to <deploy-root>/uploads/ when left blank.
# Recommended for Hostinger: set to an absolute path outside the app root so
# uploads survive re-deployments, e.g.:
#   UPLOADS_DIR=/home/<cpanel-user>/uploads
UPLOADS_DIR=

# Optional: log level (trace | debug | info | warn | error)
LOG_LEVEL=info
